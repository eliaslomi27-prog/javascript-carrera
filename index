import readline from 'readline';
import { calcularIngresoAnual, evaluarPerfil, calcularHorasEstudio } from './calculadora.js';

const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

console.log("==========================================");
console.log("   SISTEMA MODULAR DE PLAN DE CARRERA   ");
console.log("==========================================");

// Uso de funciones importadas del módulo calculadora
const salarioBase = 4000;
const ingresoAnual = calcularIngresoAnual(salarioBase);
const evaluacion = evaluarPerfil(8, "B2");

console.log(`Meta Mensual: $${salarioBase} USD | Meta Anual: $${ingresoAnual} USD`);
console.log(`Estado: ${evaluacion.mensaje}\n`);

rl.question("¿Cuántas horas diarias vas a dedicar al estudio?: ", (respuesta) => {
  const horas = Number(respuesta);
  const reporteTiempo = calcularHorasEstudio(horas);

  console.log("\n--- REPORTE DE DEDICACIÓN ---");
  console.log(`Horas semanales: ${reporteTiempo.semanales} hrs`);
  console.log(`Total acumulado (8 semanas): ${reporteTiempo.total} hrs`);
  
  if (reporteTiempo.ritmoCorrecto) {
    console.log("Evaluación: ¡Ritmo excelente para conseguir trabajo rápido!");
  } else {
    console.log("Evaluación: Te recomendamos subir a 3-4 horas diarias.");
  }

  console.log("==========================================");
  rl.close();
});