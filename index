// 8. Funciones: Calculadora de ingresos según las horas trabajadas
function calcularSalarioPorHoras(horasPorSemana, tarifaPorHora) {
  let horasAlMes = horasPorSemana * 4;
  let ingresoMensual = horasAlMes * tarifaPorHora;
  return ingresoMensual;
}

// Usamos la función con diferentes escenarios
let trabajoTiempoCompleto = calcularSalarioPorHoras(40, 25); // 40 hrs/semana a $25/hr
let trabajoFreelance = calcularSalarioPorHoras(20, 45);        // 20 hrs/semana a $45/hr

console.log("\n--- CALCULADORA DE INGRESOS CON FUNCIONES ---");
console.log("Opción 1 (Tiempo Completo):", "$" + trabajoTiempoCompleto + " USD/mes");
console.log("Opción 2 (Freelance Especializado):", "$" + trabajoFreelance + " USD/mes");
console.log("==========================================");
// 9. Entrada de datos por teclado (Programa Interactivo)
const readline = require('readline');

const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

console.log("\n==========================================");
console.log("   TEST DE SIMULACIÓN DE CARRERA TECH");
console.log("==========================================");

rl.question("¿Cuántas horas diarias vas a estudiar?: ", (horasRespuesta) => {
  let horasDiarias = Number(horasRespuesta);
  let horasSemanales = horasDiarias * 5;
  let totalHoras8Semanas = horasSemanales * 8;

  console.log("\n--- RESULTADO DE TU DEDICACIÓN ---");
  console.log("Horas a la semana:", horasSemanales + " hrs");
  console.log("Total de horas en 8 semanas:", totalHoras8Semanas + " hrs");

  if (totalHoras8Semanas >= 120) {
    console.log("EVALUACIÓN: ¡Ritmo excelente para conseguir trabajo rápido!");
  } else {
    console.log("EVALUACIÓN: Te recomendamos subir a 3-4 horas diarias.");
  }
  
  console.log("==========================================");
  rl.close(); // Cierra la interfaz de lectura
});